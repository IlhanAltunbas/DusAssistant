# Copy to .env and fill in. Never commit .env.
# Comments are on their own lines on purpose: some env_file parsers treat
# trailing "# ..." as part of the value.

# Which implementations to use (defaults match production).
# LLM_PROVIDER: azure | claude
# VECTOR_STORE: azure_search | qdrant
LLM_PROVIDER=azure
VECTOR_STORE=azure_search

# Shared secret the mobile app sends in the X-API-Key header. Required: the API refuses to start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Embeddings (used by both vector stores)
OPENAI_API_KEY=

# Azure OpenAI (LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional, default low. One of: minimal | low | medium | high
# AZURE_OPENAI_REASONING_EFFORT=low

# Azure AI Search (VECTOR_STORE=azure_search)
# The query key is read-only and is the only key the API needs.
# The admin key has write access and is only needed by scripts/veri_yukle.py.
AZURE_SEARCH_ENDPOINT=https://<service-name>.search.windows.net
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_ADMIN_KEY=
# AZURE_SEARCH_INDEX=periodontoloji-notlari

# Anthropic (LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Qdrant (VECTOR_STORE=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
